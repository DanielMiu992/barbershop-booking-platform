{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "module": "commonjs",
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@prisma/client": ["./src/generated/prisma/client"]
    }

    
  },
  "exclude": ["node_modules", "src/generated", "prisma.config.ts"]
  //"include": ["src/**/*", "prisma.config.ts"] 
}
