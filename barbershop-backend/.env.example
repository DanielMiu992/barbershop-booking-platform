# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/barbershop

# JWT signing secret (use a long random string)
JWT_SECRET=change-me

# SMTP (email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Barbershop <no-reply@example.com>"

# Address shown in emails and calendar invites
SALON_ADDRESS="Street 1, Bucharest"

# Optional: Redis (for distributed rate limiting)
REDIS_URL=redis://localhost:6379
